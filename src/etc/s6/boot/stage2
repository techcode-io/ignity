#!/usr/lib/ignity/bin/execlineb -S0

# This file is executed (not as process 1!) as soon as s6-svscan
# starts, with the original stdin/out/err and the environment of stage 1.
# Purpose of this file: to perform all the one-time initialization tasks.

# IGNITY_MODE (validated in stage 1):
#  - full:     init scripts, services, then CMD
#  - init:     init scripts only, then exit (e.g. a Kubernetes init container)
#  - services: services, then CMD (init scripts are skipped)
importas -D full IGNITY_MODE IGNITY_MODE

foreground {
  if {
    foreground {
      # Copy user provided files to /run/ignity, only the ones this mode needs.
      if {
        if { ifelse { eltest ${IGNITY_MODE} = services } { exit 0 } /etc/s6/boot/stage2-copy init }
        if { ifelse { eltest ${IGNITY_MODE} = init } { exit 0 } /etc/s6/boot/stage2-copy finalize }
        ifelse { eltest ${IGNITY_MODE} = init } { exit 0 } /etc/s6/boot/stage2-copy services
      }

      # init: one-time init scripts
      # services: long-lived processes to be supervised
      ifelse { eltest ${IGNITY_MODE} = init } { /etc/s6/boot/stage2-init }
      ifelse { eltest ${IGNITY_MODE} = services } { /etc/s6/boot/stage2-services }
      /etc/s6/boot/stage2-init /etc/s6/boot/stage2-services
    }

    importas -u ? ?
    foreground { redirfd -w 1 /run/ignity/stage2-exited s6-echo -n -- "${?}" }
    exit ${?}
  }

  # Nothing is left to supervise in init mode, stop the supervision tree.
  # A failure of the init scripts is handled below, the same way.
  ifelse { eltest ${IGNITY_MODE} = init } { s6-svscanctl -t /run/ignity/services-state }

  # The init is complete, If the user has a given CMD, run it now, then kill everything when it exits.
  if -t { eltest $# -ne 0 }
  foreground { s6-setsid -gq -d 0 -- /etc/s6/boot/stage2-cmd $@ }

  importas -u ? ?
  foreground { s6-echo -- "[supervisor/cmd] ${1} exited ${?}" }

  # Make CMD exit code available in stage3
  foreground { redirfd -w 1 /run/ignity/stage2-exited s6-echo -n -- "${?}" }

  # Stop supervision tree
  foreground { s6-svscanctl -tb /run/ignity/services-state }

  # Wait to be nuked
  s6-pause -th
}

importas -u ? ?
if { eltest ${?} -ne 0 }
s6-svscanctl -t /run/ignity/services-state
